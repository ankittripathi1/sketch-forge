# Authoritative environment reference for Sketch Forge.
#
# The API validates all of this at startup (apps/api/src/lib/env.ts) and refuses
# to boot on a bad value, naming the offending variables. Copy to `.env` for
# local work, or paste into the deployment platform's environment settings.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4001
DATABASE_URL=postgres://YOUR_LOCAL_POSTGRES_USER@127.0.0.1:5432/sketchforge

# ---------------------------------------------------------------------------
# Origins
#
# PUBLIC_ORIGIN is where the browser loads the web app. It drives redirects,
# CORS, and the cross-origin check on state-changing requests.
#
# API_PUBLIC_URL is where the browser reaches the API. In production it MUST sit
# under PUBLIC_ORIGIN: the reverse proxy terminates TLS on one hostname and
# forwards /api to the API container. A separate API hostname does not work,
# because its session cookie is invisible to the web app.
#
#   production:  PUBLIC_ORIGIN=https://sketch-forge.duckdns.org
#                API_PUBLIC_URL=https://sketch-forge.duckdns.org/api
#
# Caddy, stripping the prefix before it reaches the API:
#
#   sketch-forge.duckdns.org {
#     handle_path /api/* {
#       reverse_proxy api:4001
#     }
#     handle {
#       reverse_proxy web:3000
#     }
#   }
#
# Close port 4001 to the internet once this is in place. While the API is
# directly reachable, X-Forwarded-For can be forged and TRUST_PROXY is unsafe.
# ---------------------------------------------------------------------------
PUBLIC_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4001

# Set to 1 only when the API is reachable exclusively through the reverse proxy.
# Rate limits key on the client address, which comes from X-Forwarded-For when
# this is on.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Sessions
#
# At least 32 characters. Generate with: openssl rand -base64 48
#
# To rotate without signing everyone out, move the old value to
# JWT_SECRET_PREVIOUS and put the new one in JWT_SECRET. Existing sessions keep
# verifying until they expire (7 days), and everything new is signed with the
# current secret. Drop JWT_SECRET_PREVIOUS to revoke every session at once.
# ---------------------------------------------------------------------------
JWT_SECRET=replace-this-with-at-least-32-random-characters
# JWT_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Email (required in production)
#
# EMAIL_FROM must be on a domain verified in Resend, which means adding Resend's
# SPF and DKIM records to that domain's DNS. This cannot be a duckdns.org
# subdomain: DuckDNS only serves A/AAAA records plus one TXT for ACME, so the
# DKIM record cannot be created. Sending real magic links needs a domain whose
# DNS you control.
#
# The default `onboarding@resend.dev` sandbox sender only delivers to the
# address that owns the Resend account, so magic links to anyone else vanish.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="SketchForge <login@example.com>"

# ---------------------------------------------------------------------------
# Google sign-in (optional; set both or neither)
#
# Register this exact URL in Google Cloud Console under
# Credentials > OAuth client > Authorized redirect URIs:
#
#   ${API_PUBLIC_URL}/auth/google/callback
#
# production: https://sketch-forge.duckdns.org/api/auth/google/callback
# local:      http://localhost:4001/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Web app
#
# Baked into the client bundle at build time. Leave unset in production to use
# the same-origin default of /api.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4001
# Server-side Next fetches reach the API over the internal container network.
API_INTERNAL_URL=http://api:4001

# ---------------------------------------------------------------------------
# Tests
#
# Integration tests refuse to run against a database whose name does not end in
# `_test`. See apps/api/test/setup.ts. Apply the baseline with:
#   DATABASE_URL=$TEST_DATABASE_URL bun run db:migrate   # from packages/db
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgres://YOUR_LOCAL_POSTGRES_USER@127.0.0.1:5432/sketchforge_test
