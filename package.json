{
  "name": "sketch-forge",
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "prettier": "^3.7.4",
    "turbo": "2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "nanoid": "3.3.18",
    "brace-expansion": "1.1.18",
    "js-yaml": "4.3.1",
    "postcss": "8.5.26"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "bun test --coverage packages apps/sketch-forge",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
